{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Represents the authenticated student profile and gamification stats",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "User email address"
        },
        "displayName": {
          "type": "string",
          "description": "User display name"
        },
        "coins": {
          "type": "number",
          "description": "Gamification coins earned"
        },
        "streakDays": {
          "type": "number",
          "description": "Consecutive study days"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last update"
        }
      },
      "required": ["userId", "email"]
    },
    "StudySession": {
      "title": "StudySession",
      "description": "A completed or active study block/session",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner user ID"
        },
        "subject": {
          "type": "string",
          "description": "Subject name"
        },
        "durationSeconds": {
          "type": "number",
          "description": "Time spent in seconds"
        },
        "coinsEarned": {
          "type": "number",
          "description": "Coins earned in session"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp"
        }
      },
      "required": ["userId", "subject", "durationSeconds"]
    },
    "StudyNote": {
      "title": "StudyNote",
      "description": "User notes or audio transcripts",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner user ID"
        },
        "title": {
          "type": "string",
          "description": "Note title"
        },
        "content": {
          "type": "string",
          "description": "Note text content or transcription"
        },
        "source": {
          "type": "string",
          "description": "Source e.g. manual, audio_transcribe, ai_chat"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp"
        }
      },
      "required": ["userId", "title", "content"]
    },
    "AiChatMessage": {
      "title": "AiChatMessage",
      "description": "Messages in multi-turn AI tutoring chats",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner user ID"
        },
        "role": {
          "type": "string",
          "enum": ["user", "model", "system"],
          "description": "Role of the speaker"
        },
        "content": {
          "type": "string",
          "description": "Message text"
        },
        "model": {
          "type": "string",
          "description": "Gemini model used"
        },
        "sources": {
          "type": "string",
          "description": "JSON string of search grounding sources if applicable"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp"
        }
      },
      "required": ["userId", "role", "content"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile document keyed by auth UID"
    },
    "/users/{userId}/sessions/{sessionId}": {
      "schema": "StudySession",
      "description": "User's completed study sessions"
    },
    "/users/{userId}/notes/{noteId}": {
      "schema": "StudyNote",
      "description": "User's notes and transcribed study recordings"
    },
    "/users/{userId}/chats/{chatId}": {
      "schema": "AiChatMessage",
      "description": "User's chat history with Gemini study assistant"
    }
  }
}
